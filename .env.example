# Required for scanner/checks/prompt_injection.py's real Claude API check.
# Without this set, every tool is reported needs_review rather than the
# check being silently skipped.
ANTHROPIC_API_KEY=

# Optional — only needed when scanning a remote target with
# --url/--bearer-token-env, e.g.:
#   export PACT_STAGE_TOKEN=...
#   python -m scanner.run_scan --slug pact-stage --url https://stage.acs-pact.com/mcp --bearer-token-env PACT_STAGE_TOKEN
